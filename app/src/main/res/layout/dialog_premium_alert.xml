<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDialogRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:strokeColor="#F1F5F9"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Circular Icon Badge -->
            <FrameLayout
                android:id="@+id/frameDialogIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_dialog_icon_circle">

                <ImageView
                    android:id="@+id/ivDialogIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="Dialog Icon"
                    android:src="@drawable/ic_alert_triangle"
                    app:tint="#DC2626" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Connection Error"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Optional Badge / Tag -->
            <TextView
                android:id="@+id/tvDialogBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_code_rose"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="AUTHENTICATION"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Message Body -->
            <TextView
                android:id="@+id/tvDialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Unable to connect to server. Please check your network connection and try again."
                android:textColor="#475569"
                android:textSize="14sp" />

            <!-- Custom Content Slot -->
            <FrameLayout
                android:id="@+id/containerCustomContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- Button Row Container -->
            <LinearLayout
                android:id="@+id/layoutDialogButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialogSecondary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F1F5F9"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#475569"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="14dp"
                    app:elevation="0dp"
                    app:rippleColor="#E2E8F0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDialogPrimary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1D4ED8"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="OK"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:elevation="2dp"
                    app:rippleColor="#60A5FA" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>

