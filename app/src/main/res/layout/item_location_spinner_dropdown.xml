<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/ivDropdownPin"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_map_pin"
        app:tint="#2563EB"
        android:contentDescription="Location Pin" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDropdownLocationName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location Name"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDropdownLocationCoords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ID: 12 • Lat: 8.1866, Lng: 77.4247"
            android:textColor="#64748B"
            android:textSize="11.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivDropdownCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="#10B981"
        android:contentDescription="Selected Check" />

</LinearLayout>
